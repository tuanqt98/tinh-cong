{
  "name": "tinh-cong-in-nhat-han",
  "version": "0.1.0",
  "private": true,
  "description": "Hệ thống quản lý chấm công nội bộ Công ty TNHH In Nhật Hàn",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.17.0",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @tinh-cong/api --filter @tinh-cong/web dev",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm -r --if-present test",
    "test:run": "pnpm -r --if-present test:run",
    "test:engine": "pnpm --filter @tinh-cong/attendance-engine test:run",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-e2e.ps1",
    "test:integration": "pnpm --filter @tinh-cong/api test:integration",
    "test:performance": "pnpm --filter @tinh-cong/api test:performance",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "pnpm --filter @tinh-cong/api seed",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.55.1",
    "@prisma/client": "6.19.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "3.6.2",
    "prisma": "6.19.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "3.2.4"
  }
}
