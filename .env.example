NODE_ENV=development
TZ=Asia/Ho_Chi_Minh
PORT=3000
WEB_PORT=4173
DATABASE_URL=postgresql://tinhcong:tinhcong_dev_only@localhost:5432/tinhcong?schema=public
POSTGRES_DB=tinhcong
POSTGRES_USER=tinhcong
POSTGRES_PASSWORD=replace-with-a-random-local-database-password
POSTGRES_HOST_PORT=5432
COMPOSE_API_PORT=3000
COMPOSE_WEB_PORT=8080
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:4173
DUPLICATE_KEY_FIELDS=employeeCode,attendanceDate,shiftName
WORKFLOW_ENABLED=false
SOURCE_MASTER_PROVISIONING_ENABLED=false
UPLOAD_DIR=./storage/uploads
EXPORT_DIR=./storage/exports
SEED_ADMIN_USERNAME=admin.dev
SEED_ADMIN_PASSWORD=replace-with-unique-password-at-least-14-characters
SEED_HR_USERNAME=hr.dev
SEED_HR_PASSWORD=replace-with-another-unique-password-at-least-14-characters
SEED_EMPLOYEE_USERNAME=employee.dev
SEED_EMPLOYEE_PASSWORD=replace-with-a-third-unique-password-at-least-14-characters
