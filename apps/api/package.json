{
  "name": "@tinh-cong/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-prisma-client.mjs",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest",
    "test:run": "vitest run --coverage.enabled=false",
    "test:integration": "vitest run --config vitest.integration.config.ts --coverage.enabled=false",
    "test:performance": "tsx scripts/performance-check.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema ../../prisma/schema.prisma",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.1",
    "@nestjs/throttler": "6.4.0",
    "@fontsource/noto-sans": "5.2.8",
    "@prisma/client": "6.19.0",
    "@tinh-cong/attendance-engine": "workspace:*",
    "bcryptjs": "3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "helmet": "8.1.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pdfkit": "0.17.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.6",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/passport-jwt": "4.0.1",
    "@types/pdfkit": "0.17.3",
    "@types/supertest": "6.0.3",
    "prisma": "6.19.0",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
